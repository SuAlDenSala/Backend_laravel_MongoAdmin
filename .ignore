# =============================================================================
# Sensitive Data, Secrets & Credentials
# =============================================================================
# Environment files (contains DB passwords, app keys, API secrets)
.env
.env.*
!.env.example
auth.json

# Private keys, certificates, and tokens
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
oauth-*.key
id_rsa*
id_ed25519*
storage/*.key

# =============================================================================
# Large Files & Dependencies
# =============================================================================
# PHP dependencies
/vendor/

# JavaScript / Node dependencies
/node_modules/
/.pnpm-store/

# Compiled frontend production assets
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Archives, media & compressed files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.dmg

# =============================================================================
# Database Dumps, Volatile Data & Backups
# =============================================================================
# Database dumps & exports
*.sql
*.sqlite
*.sqlite-journal
*.dump
dump/
mongo_data/
/data/db/
backups/
*.bak
*.backup

# =============================================================================
# Logs & Application Cache
# =============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Laravel Framework storage
/storage/logs/*.log
/storage/pail/
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/framework/testing/.gitignore

# Test & coverage caches
.phpunit.result.cache
/.phpunit.cache/
/.pest/

# =============================================================================
# IDE, Editor & OS Metadata
# =============================================================================
# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor folders
/.idea/
/.vscode/
/.cursor/
/.zed/
/.nova/
/.codex/
/.claude/
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.php-cs-fixer.cache
Homestead.json
Homestead.yaml
